# --- API KEYS ---
OPENAI_API_KEY=sk-...
OPENALEX_API_KEY=...    # Optional but recommended for higher rate limits

# --- SECURITY ---
SCINETS_DEMO_MODE=True  # Set to False for Production
SCINETS_SECRET_KEY=change-me-to-a-long-random-string
SCINETS_ADMIN_EMAILS=["your@email.com"]

# --- DATABASE ---
# Dev (Local): sqlite:///./scinets.db
# Prod (Docker): postgresql://user:password@postgres:5432/scinets
SCINETS_DATABASE_URL=postgresql://user:password@postgres:5432/scinets

# --- EMAIL (SMTP) ---
SCINETS_SMTP_EMAIL=your-auth-email@gmail.com
SCINETS_SMTP_PASSWORD=your-app-password

# --- LIMITS (Resource Budget) ---
# Recommended for Production deployment:
SCINETS_MAX_RUN_TIME_SECONDS=600   # 10 Minutes
SCINETS_MAX_TOTAL_TOKENS=100000    # 100k Tokens
SCINETS_MAX_AGENT_STEPS=20         # Max reasoning loops

# --- QUOTAS ---
SCINETS_MAX_RUNS_PER_USER_PER_WEEK=2
